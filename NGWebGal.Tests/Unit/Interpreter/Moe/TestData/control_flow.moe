// if-else 语句测试
func int checkNumber(int num) {
    if (num > 0) {
        return 1;
    } else if (num < 0) {
        return -1;
    } else {
        return 0;
    }
}

// while 循环测试
func int factorialWhile(int n) {
    int result = 1;
    int i = 1;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

// for 循环测试
func int sumForLoop(int n) {
    int sum = 0;
    for (int i = 1; i <= n; i = i + 1) {
        sum = sum + i;
    }
    return sum;
}

// do-while 循环测试
func int countDown(int start) {
    int count = start;
    do {
        count = count - 1;
    } while (count > 0);
    return count;
}

// switch 语句测试
func string getDayName(int day) {
    switch (day) {
        case 1:
            return "Monday";
        case 2:
            return "Tuesday";
        case 3:
            return "Wednesday";
        case 4:
            return "Thursday";
        case 5:
            return "Friday";
        case 6:
            return "Saturday";
        case 7:
            return "Sunday";
        default:
            return "Invalid day";
    }
}

// 嵌套控制流
func void complexControlFlow(int x, int y) {
    if (x > 0) {
        for (int i = 0; i < x; i = i + 1) {
            while (y > 0) {
                if (i % 2 == 0) {
                    y = y - 1;
                } else {
                    y = y - 2;
                }
            }
        }
    }
}