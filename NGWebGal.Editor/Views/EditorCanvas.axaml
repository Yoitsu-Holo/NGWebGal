<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NGWebGal.Editor.Views">
    <!-- EditorCanvas styles - control is entirely code-based for custom rendering -->
    <Style Selector="views|EditorCanvas">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
</Styles>
