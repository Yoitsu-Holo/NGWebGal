<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NGWebGal.Editor.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NGWebGal.Editor.Views.EditorCanvasWrapper"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Modern scrollbar styling -->
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="12"/>
        </Style>

        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="12"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#A0A0A0"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#808080"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="ScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Border x:Name="ZoomBorder"
                Background="Transparent"
                RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding #Root.ZoomLevel}"
                                ScaleY="{Binding #Root.ZoomLevel}"/>
            </Border.RenderTransform>

            <views:EditorCanvas x:Name="Canvas"
                                Width="{Binding #Root.CanvasWidth}"
                                Height="{Binding #Root.CanvasHeight}"
                                ShowPercentageLines="{Binding #Root.ShowPercentageLines}"
                                ShowGridLines="{Binding #Root.ShowGridLines}"
                                GridSpacing="{Binding #Root.GridSpacing}"
                                Widgets="{Binding #Root.Widgets}"
                                SelectedWidget="{Binding #Root.SelectedWidget, Mode=TwoWay}"
                                AddWidgetCommand="{Binding #Root.AddWidgetCommand}"/>
        </Border>
    </ScrollViewer>
</UserControl>
