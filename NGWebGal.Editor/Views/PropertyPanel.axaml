<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NGWebGal.Editor.ViewModels"
             x:Class="NGWebGal.Editor.Views.PropertyPanel"
             x:DataType="vm:MainViewModel">

    <Border Background="#F5F5F5"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <!-- Title -->
                <TextBlock Text="Properties"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#333333" />

                <!-- Separator -->
                <Border Height="1"
                        Background="#DDDDDD"
                        Margin="0,2" />

                <!-- No selection message -->
                <TextBlock Text="No widget selected"
                           FontStyle="Italic"
                           FontSize="12"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,14">
                    <TextBlock.IsVisible>
                        <Binding Path="SelectedWidget" Converter="{x:Static ObjectConverters.IsNull}" />
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Dynamic property editors grouped by type hierarchy -->
                <ContentControl DataContext="{Binding PropertyPanelVM}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                    <ContentControl.IsVisible>
                        <Binding Path="SelectedLayer" Converter="{x:Static ObjectConverters.IsNotNull}" />
                    </ContentControl.IsVisible>

                    <ItemsControl ItemsSource="{Binding PropertyGroups}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PropertyGroupViewModel">
                                <Expander IsExpanded="{Binding IsExpanded}"
                                          Background="White"
                                          BorderBrush="#BBBBBB"
                                          BorderThickness="1"
                                          CornerRadius="3"
                                          Margin="0,0,0,6"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#444444" />
                                            <TextBlock Text="{Binding HierarchyDepth, StringFormat='(depth {0})'}"
                                                       FontSize="10"
                                                       Foreground="#888888"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <Border Background="#FAFAFA"
                                            Padding="8,6">
                                        <ItemsControl ItemsSource="{Binding Editors}"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding Control}"
                                                                    Margin="0,0,0,4"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
