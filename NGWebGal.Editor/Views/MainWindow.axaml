<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:NGWebGal.Editor.Converters"
        xmlns:views="using:NGWebGal.Editor.Views"
        xmlns:controls="using:NGWebGal.Editor.Controls"
        xmlns:vm="using:NGWebGal.Editor.ViewModels"
        x:Class="NGWebGal.Editor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WebGal Editor"
        Width="1280"
        Height="720"
        Background="#FFFFFF">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:WidgetTypeToBrushConverter x:Key="WidgetTypeToBrushConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Style for checkable menu items to show checkmark -->
        <Style Selector="MenuItem">
            <Setter Property="Icon">
                <Template>
                    <Panel Width="16" Height="16">
                        <TextBlock Text="✓"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding $parent[MenuItem].IsChecked}" />
                    </Panel>
                </Template>
            </Setter>
        </Style>
    </Window.Styles>

    <DockPanel Background="#F0F0F0">
        <!-- Menu Bar (Top) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Layout"
                          Command="{Binding NewLayoutCommand}"
                          InputGesture="Ctrl+N" />
                <MenuItem Header="_Open Layout..."
                          Command="{Binding OpenLayoutCommand}"
                          InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save Layout"
                          Command="{Binding SaveLayoutCommand}"
                          InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..."
                          Command="{Binding SaveAsLayoutCommand}"
                          InputGesture="Ctrl+Shift+S" />
                <MenuItem Header="_Export TXT..."
                          Command="{Binding ExportTxtCommand}"
                          InputGesture="Ctrl+E" />
                <Separator />
                <MenuItem Header="E_xit"
                          Click="OnExitMenuItemClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Delete Widget"
                          Command="{Binding DeleteWidgetCommand}"
                          InputGesture="Delete" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Canvas _Settings..."
                          Command="{Binding ShowCanvasSettingsCommand}" />
                <Separator />
                <MenuItem Header="Show _Percentage Lines"
                          IsChecked="{Binding ShowPercentageLines, Mode=TwoWay}"
                          StaysOpenOnClick="True" />
                <MenuItem Header="Show _Grid Lines"
                          IsChecked="{Binding ShowGridLines, Mode=TwoWay}"
                          StaysOpenOnClick="True" />
            </MenuItem>
        </Menu>

        <!-- Toolbox Panel (Left) -->
        <views:ToolboxPanel DockPanel.Dock="Left"
                            Width="200"
                            Margin="4" />

        <!-- Property Panel (Right) -->
        <views:PropertyPanel DockPanel.Dock="Right"
                             Width="350"
                             Margin="4"
                             DataContext="{Binding}" />

        <!-- Zoom Control (Bottom) -->
        <Border DockPanel.Dock="Bottom"
                Background="#E8E8E8"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <controls:ZoomControl ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                  HorizontalAlignment="Right" />
        </Border>

        <!-- Editor Canvas Wrapper (Center - fills remaining space) -->
        <views:EditorCanvasWrapper Margin="4"
                                   CanvasWidth="{Binding CanvasWidth}"
                                   CanvasHeight="{Binding CanvasHeight}"
                                   ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                   ShowPercentageLines="{Binding ShowPercentageLines}"
                                   ShowGridLines="{Binding ShowGridLines}"
                                   GridSpacing="{Binding GridSpacing}"
                                   Widgets="{Binding Widgets}"
                                   SelectedWidget="{Binding SelectedWidget, Mode=TwoWay}"
                                   AddWidgetCommand="{Binding AddWidgetCommand}" />
    </DockPanel>
</Window>
