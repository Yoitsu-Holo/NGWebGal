<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NGWebGal.Editor.Views.CanvasSettingsDialog"
        Title="Canvas Settings"
        Width="400"
        Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">

    <StackPanel Margin="20" Spacing="15">
        <!-- Canvas Width -->
        <StackPanel Spacing="5">
            <TextBlock Text="Canvas Width:" FontWeight="SemiBold" />
            <NumericUpDown Name="WidthNumericUpDown"
                           Minimum="100"
                           Maximum="10000"
                           Increment="10"
                           FormatString="0"
                           Width="200"
                           HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Canvas Height -->
        <StackPanel Spacing="5">
            <TextBlock Text="Canvas Height:" FontWeight="SemiBold" />
            <NumericUpDown Name="HeightNumericUpDown"
                           Minimum="100"
                           Maximum="10000"
                           Increment="10"
                           FormatString="0"
                           Width="200"
                           HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">
            <Button Name="OkButton"
                    Content="OK"
                    Width="80"
                    IsDefault="True"
                    Click="OnOkButtonClick" />
            <Button Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    IsCancel="True"
                    Click="OnCancelButtonClick" />
        </StackPanel>
    </StackPanel>
</Window>
