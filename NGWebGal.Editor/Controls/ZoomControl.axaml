<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NGWebGal.Editor.Controls.ZoomControl"
             HorizontalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
        <!-- Zoom Label -->
        <TextBlock Text="Zoom:"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#555555" />

        <!-- Zoom Slider -->
        <Slider x:Name="ZoomSlider"
                Minimum="0.1"
                Maximum="5.0"
                Value="1.0"
                Width="120"
                VerticalAlignment="Center"
                TickFrequency="0.1"
                IsSnapToTickEnabled="False" />

        <!-- Percentage Display -->
        <TextBlock x:Name="PercentageText"
                   Text="100%"
                   VerticalAlignment="Center"
                   FontSize="11"
                   MinWidth="45"
                   TextAlignment="Right"
                   Foreground="#333333" />

        <!-- Reset Button -->
        <Button x:Name="ResetButton"
                Content="1:1"
                VerticalAlignment="Center"
                FontSize="10"
                Padding="6,2"
                MinWidth="35"
                ToolTip.Tip="Reset zoom to 100%" />
    </StackPanel>
</UserControl>
