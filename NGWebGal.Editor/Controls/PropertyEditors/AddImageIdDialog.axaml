<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NGWebGal.Editor.Controls.PropertyEditors.AddImageIdDialog"
        Title="添加图像ID"
        Width="300" Height="150"
        CanResize="false"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="请输入新的图像ID（可以是负数）：" FontSize="12"/>
    <NumericUpDown x:Name="IdNumeric"
                   Value="0"
                   Increment="1"
                   FormatString="0"
                   Height="24"
                   FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="确定" Width="80" Height="24" Click="OnOkClick"/>
      <Button Content="取消" Width="80" Height="24" Click="OnCancelClick"/>
    </StackPanel>
  </StackPanel>
</Window>
